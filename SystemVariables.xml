  <category name="Multiview Window Source">
    <variable name="Window 1 Source" sysvar="WinSrc1" type="string" sample="TX1" />
    <variable name="Window 2 Source" sysvar="WinSrc2" type="string" sample="TX1" />
    <variable name="Window 3 Source" sysvar="WinSrc3" type="string" sample="TX1" />
