<?xml version="1.0" encoding="utf-8"?>
<variables>
  <category name="Status">
    <variable name="Connection Status" sysvar="ConnStatus" type="boolean" format="B:Disconnected:Connected" sample="true" />
  </category>

  <category name="Command Feedback">
    <variable name="Last Command Success" sysvar="LastCommandSuccess" type="boolean" format="B:Error:OK" sample="true" />
    <variable name="Last Command Sent" sysvar="LastCommandSent" type="string" sample="matrix aset :av TX1 RX1" />
    <variable name="Last Response (Raw)" sysvar="LastResponseRaw" type="string" sample="{&quot;cmd&quot;:&quot;matrix active mx1&quot;,&quot;info&quot;:&quot;OK&quot;,&quot;code&quot;:0}" />
    <variable name="Last Response Command" sysvar="LastResponseCmd" type="string" sample="matrix active mx1" />
    <variable name="Last Response Info" sysvar="LastResponseInfo" type="string" sample="OK" />
    <variable name="Last Response Code" sysvar="LastResponseCode" type="integer" sample="0" />
  </category>

  <category name="System State">
    <variable name="Active Matrix Name" sysvar="ActiveMatrix" type="string" sample="mx1" />
    <variable name="Active Layout Name" sysvar="ActiveLayout" type="string" sample="15" />
    <variable name="Active Video Wall" sysvar="ActiveWall" type="string" sample="videowall2" />
    <variable name="Active Wall Layout" sysvar="ActiveWallLayout" type="string" sample="vlayout1" />
    <variable name="Device Status (Raw)" sysvar="DeviceStatusRaw" type="string" sample="{&quot;cmd&quot;:&quot;config get device status ALL&quot;,...}" />
  </category>

  <category name="Multiview Routing">
    <variable name="Selected Window ID" sysvar="SelectedWindowID" type="integer" sample="1" />
    <variable name="Selected Layout ID" sysvar="SelectedLayoutID" type="integer" sample="1" />
    <variable name="Selected Layout" sysvar="SelectedLayout" type="string" sample="lay1" />
  </category>

  <!-- Per-window booleans: true only for the armed window. Bind a Select -->
  <!-- Window button's Reversed state directly to its matching WinSelN.    -->
  <category name="Multiview Window Selected">
    <variable name="Window 1 Selected" sysvar="WinSel1" type="boolean" sample="false" />
    <variable name="Window 2 Selected" sysvar="WinSel2" type="boolean" sample="false" />
    <variable name="Window 3 Selected" sysvar="WinSel3" type="boolean" sample="false" />
    <variable name="Window 4 Selected" sysvar="WinSel4" type="boolean" sample="false" />
    <variable name="Window 5 Selected" sysvar="WinSel5" type="boolean" sample="false" />
    <variable name="Window 6 Selected" sysvar="WinSel6" type="boolean" sample="false" />
    <variable name="Window 7 Selected" sysvar="WinSel7" type="boolean" sample="false" />
    <variable name="Window 8 Selected" sysvar="WinSel8" type="boolean" sample="false" />
    <variable name="Window 9 Selected" sysvar="WinSel9" type="boolean" sample="false" />
    <variable name="Window 10 Selected" sysvar="WinSel10" type="boolean" sample="false" />
    <variable name="Window 11 Selected" sysvar="WinSel11" type="boolean" sample="false" />
    <variable name="Window 12 Selected" sysvar="WinSel12" type="boolean" sample="false" />
    <variable name="Window 13 Selected" sysvar="WinSel13" type="boolean" sample="false" />
    <variable name="Window 14 Selected" sysvar="WinSel14" type="boolean" sample="false" />
    <variable name="Window 15 Selected" sysvar="WinSel15" type="boolean" sample="false" />
    <variable name="Window 16 Selected" sysvar="WinSel16" type="boolean" sample="false" />
  </category>

  <!-- Per-window current source (the TX/source shown in each window). -->
  <category name="Multiview Window Source">
    <variable name="Window 1 Source" sysvar="WinSrc1" type="string" sample="TX1" />
    <variable name="Window 2 Source" sysvar="WinSrc2" type="string" sample="TX1" />
    <variable name="Window 3 Source" sysvar="WinSrc3" type="string" sample="TX1" />
    <variable name="Window 4 Source" sysvar="WinSrc4" type="string" sample="TX1" />
    <variable name="Window 5 Source" sysvar="WinSrc5" type="string" sample="TX1" />
    <variable name="Window 6 Source" sysvar="WinSrc6" type="string" sample="TX1" />
    <variable name="Window 7 Source" sysvar="WinSrc7" type="string" sample="TX1" />
    <variable name="Window 8 Source" sysvar="WinSrc8" type="string" sample="TX1" />
    <variable name="Window 9 Source" sysvar="WinSrc9" type="string" sample="TX1" />
    <variable name="Window 10 Source" sysvar="WinSrc10" type="string" sample="TX1" />
    <variable name="Window 11 Source" sysvar="WinSrc11" type="string" sample="TX1" />
    <variable name="Window 12 Source" sysvar="WinSrc12" type="string" sample="TX1" />
    <variable name="Window 13 Source" sysvar="WinSrc13" type="string" sample="TX1" />
    <variable name="Window 14 Source" sysvar="WinSrc14" type="string" sample="TX1" />
    <variable name="Window 15 Source" sysvar="WinSrc15" type="string" sample="TX1" />
    <variable name="Window 16 Source" sysvar="WinSrc16" type="string" sample="TX1" />
  </category>
</variables>
