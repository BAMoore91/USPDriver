  <category name="Multiview Routing">
    <variable name="Selected Window ID" sysvar="SelectedWindowID" type="integer" sample="1" />
    <variable name="Selected Layout ID" sysvar="SelectedLayoutID" type="integer" sample="1" />
    <variable name="Selected Layout" sysvar="SelectedLayout" type="string" sample="lay1" />
  </category>

  <!-- Per-window booleans: true only for the armed window. Bind a Select -->
  <!-- Window button's Reversed state directly to its matching WinSelN.    -->
  <category name="Multiview Window Selected">
    <variable name="Window 1 Selected" sysvar="WinSel1" type="boolean" sample="false" />
    <variable name="Window 2 Selected" sysvar="WinSel2" type="boolean" sample="false" />
