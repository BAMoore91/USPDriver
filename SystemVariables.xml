  <!-- each list variable; wire its select command to the matching Select fn. -->
  <category name="Live Lists (from CBOX)">
    <variable name="Source List" sysvar="SourceList" type="list" />
    <variable name="Display List" sysvar="DisplayList" type="list" />
    <variable name="Layout List" sysvar="LayoutList" type="list" />
    <variable name="Playlist List" sysvar="PlaylistList" type="list" />
    <variable name="Selected Source" sysvar="LiveSource" type="string" sample="TX1" />
    <variable name="Selected Display" sysvar="LiveDisplay" type="string" sample="RX1" />
    <variable name="Selected Display Source" sysvar="LiveDisplaySource" type="string" sample="TX1" />
    <variable name="Selected Layout" sysvar="LiveLayout" type="string" sample="15" />
    <variable name="Selected Playlist" sysvar="LivePlaylist" type="string" sample="CAZLogo" />
  </category>
</variables>
